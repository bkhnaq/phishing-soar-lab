# Mẫu biến môi trường / workflow variables. Copy thành .env và điền giá trị thật.
# .env đã được .gitignore, KHÔNG commit file chứa giá trị thật.

# --- Shuffle workflow variables (đặt trong Shuffle > workflow > Variables) ---
THEHIVE_URL=https://<thehive-host>/thehive
THEHIVE_API_KEY=<api-key-cua-tai-khoan-dich-vu-shuffle>
# Chỉ cần nếu bật gửi Telegram cho người báo cáo (NOTIFY_REPORTER=True trong node 4)
TELEGRAM_BOT_TOKEN=<telegram-bot-token>

# --- Wazuh ---
SHUFFLE_WEBHOOK_URL=https://shuffler.io/api/v1/hooks/webhook_xxxxxxxx

# --- Cortex analyzer API keys (nhập trong Cortex UI, không dùng trực tiếp ở đây) ---
VIRUSTOTAL_API_KEY=<...>
ABUSEIPDB_API_KEY=<...>
URLSCAN_API_KEY=<...>
